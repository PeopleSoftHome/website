# ============================================================
# TalentPro 前端运行时配置示例（Nuxt 3 runtimeConfig.public）
# 复制此文件为 .env 并根据环境修改
# 公开变量必须以 NUXT_PUBLIC_ 前缀暴露给浏览器端
# ============================================================

# API 基础地址（必须）
# 开发环境使用本地后端，生产环境使用真实域名
NUXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# 应用环境标识（development | staging | production）
NUXT_PUBLIC_APP_ENV=development

# Sentry 错误监控 DSN（可选）
# 用于生产环境错误追踪，开发环境可留空
# NUXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# reCAPTCHA v3 Site Key（可选）
# 用于 AI 对话接口与注册/预约演示的机器人验证，未配置则跳过
# NUXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# 静态资源 CDN 基础地址（可选，如 https://cdn.example.com/）
# NUXT_PUBLIC_ASSET_BASE_URL=/
