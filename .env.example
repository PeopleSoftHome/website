# ============================================================
# TalentPro 前端环境变量示例
# 复制此文件为 .env 并根据环境修改
# ============================================================

# API 基础地址（必须）
# 开发环境使用本地后端，生产环境使用真实域名
VITE_API_BASE_URL=http://localhost:4000/api/v1

# 应用环境标识（development | staging | production）
VITE_APP_ENV=development

# Sentry 错误监控 DSN（可选）
# 用于生产环境错误追踪，开发环境可留空
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# reCAPTCHA v3 Site Key（可选）
# 用于 AI 对话接口的机器人验证，未配置则跳过
# VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# 静态资源 CDN 基础地址（可选，如 https://cdn.example.com/）
# VITE_ASSET_BASE_URL=/
