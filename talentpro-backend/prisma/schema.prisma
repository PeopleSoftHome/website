generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== Enums ====================

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
  PENDING
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DEMOED
  NEGOTIATION
  WON
  LOST
}

enum WorkspacePlan {
  FREE
  PRO
  ENTERPRISE
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum DemoBookingScale {
  SCALE_1_10
  SCALE_11_50
  SCALE_51_200
  SCALE_200_PLUS
}

enum LeadSource {
  WEBSITE
  ADS
  REFERRAL
  ORGANIC
}

enum ResourceType {
  ARTICLE
  WHITEPAPER
  VIDEO
  CASE_STUDY
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  ENDED
}

enum SensitiveWordCategory {
  SPAM
  AD
  OFFENSIVE
  POLITICAL
}

enum TokenType {
  ACCESS
  REFRESH
}

enum NotificationType {
  COMMENT_REPLY
  MENTION
  SYSTEM
  FOLLOW_UP
}

// ==================== Identity ====================

model User {
  id            String         @id @default(uuid())
  email         String
  password      String
  name          String?
  avatar        String?
  phone         String?
  bio           String?
  status        UserStatus     @default(ACTIVE)
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  workspaceId   String?
  workspace     Workspace?     @relation(fields: [workspaceId], references: [id])
  workspaceRole WorkspaceRole? @default(MEMBER)
  abVariant     String? // A/B测试分组
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  posts            BlogPost[]
  topics           ForumTopic[]
  replies          ForumPost[]
  comments         Comment[]
  activities       UserActivity[]
  auditLogs        AuditLog[]
  downloads        DownloadRecord[]
  notifications    Notification[]
  medias           Media[]
  followUps        FollowUp[]
  assignedBookings DemoBooking[]    @relation("AssignedBookings")
  updatedSettings  Setting[]
  ownedWorkspaces  Workspace[]      @relation("WorkspaceOwner")

  @@unique([email, workspaceId])
  @@index([email])
  @@index([workspaceId])
  @@index([roleId])
  @@map("users")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid())
  resource String
  action   String
  roles    Role[]

  @@unique([resource, action])
  @@map("permissions")
}

model Workspace {
  id        String          @id @default(uuid())
  name      String
  slug      String          @unique
  plan      WorkspacePlan   @default(FREE)
  status    WorkspaceStatus @default(ACTIVE)
  ownerId   String
  owner     User            @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  users     User[]
  invites   WorkspaceInvite[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("workspaces")
}

model WorkspaceInvite {
  id          String    @id @default(uuid())
  email       String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  token       String    @unique
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([workspaceId])
  @@map("workspace_invites")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ==================== CMS Core ====================

model Page {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean   @default(false)
  sections    Section[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("pages")
}

model Section {
  id        String  @id @default(uuid())
  pageId    String
  page      Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String
  sortOrder Int     @default(0)
  config    Json    @default("{}")
  isActive  Boolean @default(true)

  @@index([pageId])
  @@map("sections")
}

model Translation {
  id      String  @id @default(uuid())
  locale  String
  key     String
  value   String  @db.Text
  context String?

  @@unique([locale, key])
  @@index([locale, context])
  @@map("translations")
}

// ==================== Navigation ====================

model Navigation {
  id        String    @id @default(uuid())
  key       String    @unique
  label     String
  location  String    @default("header")
  items     NavItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("navigations")
}

model NavItem {
  id           String     @id @default(uuid())
  navigationId String
  navigation   Navigation @relation(fields: [navigationId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       NavItem?   @relation("NavChildren", fields: [parentId], references: [id])
  children     NavItem[]  @relation("NavChildren")
  label        String
  href         String?
  icon         String?
  description  String?
  sortOrder    Int        @default(0)
  isExternal   Boolean    @default(false)

  @@index([navigationId])
  @@index([parentId])
  @@map("nav_items")
}

// ==================== Products ====================

model ProductTab {
  id        String    @id @default(uuid())
  label     String
  slug      String    @unique
  icon      String?
  iconColor String?
  iconBg    String?
  sortOrder Int       @default(0)
  products  Product[]

  @@map("product_tabs")
}

model Product {
  id          String     @id @default(uuid())
  tabId       String
  tab         ProductTab @relation(fields: [tabId], references: [id])
  slug        String     @unique
  name        String
  tagline     String
  description String?    @db.Text
  icon        String?
  features    Json?      @default("[]")
  isPublished Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([tabId])
  @@index([isPublished])
  @@map("products")
}

// ==================== Industries ====================

model Industry {
  id          String   @id @default(uuid())
  slug        String   @unique
  label       String
  icon        String?
  features    Json?    @default("[]")
  screenshot  Json?    @default("{}")
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("industries")
}

// ==================== Testimonials ====================

model Testimonial {
  id        String   @id @default(uuid())
  industry  String
  product   String
  text      String   @db.Text
  name      String
  title     String
  avatar    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("testimonials")
}

// ==================== Stats ====================

model Stat {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  value     String
  suffix    String?
  prefix    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("stats")
}

// ==================== Client Logos ====================

model ClientLogo {
  id        String   @id @default(uuid())
  name      String
  logo      String
  industry  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("client_logos")
}

// ==================== WhyUs ====================

model WhyUsTab {
  id        String   @id @default(uuid())
  label     String
  slug      String   @unique
  icon      String?
  metrics   Json?    @default("[]")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("why_us_tabs")
}

// ==================== AI Family ====================

model AiCard {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  tagline     String
  description String?  @db.Text
  icon        String?
  features    Json?    @default("[]")
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("ai_cards")
}

// ==================== Resources ====================

model ResourceCategory {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  resources   Resource[]

  @@map("resource_categories")
}

model Resource {
  id               String           @id @default(uuid())
  categoryId       String
  category         ResourceCategory @relation(fields: [categoryId], references: [id])
  slug             String           @unique
  title            String
  description      String?          @db.Text
  coverImage       String?
  fileUrl          String?
  type             ResourceType     @default(ARTICLE)
  status           PostStatus       @default(DRAFT)
  requiresLeadInfo Boolean          @default(false) // 下载前是否需要留资
  viewCount        Int              @default(0)
  downloadCount    Int              @default(0)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  downloads        DownloadRecord[]

  @@index([categoryId])
  @@index([status])
  @@map("resources")
}

model DownloadRecord {
  id         String   @id @default(uuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])
  name       String
  email      String
  company    String?
  phone      String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([resourceId])
  @@index([userId])
  @@map("download_records")
}

// ==================== Blog ====================

model BlogCategory {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  posts       BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id          String       @id @default(uuid())
  title       String
  slug        String
  excerpt     String?
  content     String       @db.Text
  coverImage  String?
  status      PostStatus   @default(DRAFT)
  viewCount   Int          @default(0)
  publishedAt DateTime?
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  categoryId  String
  category    BlogCategory @relation(fields: [categoryId], references: [id])
  workspaceId String?
  tags        Tag[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@unique([slug, workspaceId])
  @@index([status, publishedAt])
  @@index([slug])
  @@index([authorId])
  @@index([categoryId])
  @@index([workspaceId])
  @@map("blog_posts")
}

model Tag {
  id    String     @id @default(uuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]

  @@map("tags")
}

// ==================== Forum ====================

model ForumCategory {
  id          String       @id @default(uuid())
  name        String
  description String?
  sortOrder   Int          @default(0)
  topics      ForumTopic[]

  @@map("forum_categories")
}

model ForumTopic {
  id          String        @id @default(uuid())
  categoryId  String
  category    ForumCategory @relation(fields: [categoryId], references: [id])
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  title       String
  content     String        @db.Text
  isPinned    Boolean       @default(false)
  isLocked    Boolean       @default(false)
  viewCount   Int           @default(0)
  replyCount  Int           @default(0)
  workspaceId String?
  posts       ForumPost[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([categoryId])
  @@index([authorId])
  @@index([workspaceId])
  @@map("forum_topics")
}

model ForumPost {
  id          String     @id @default(uuid())
  topicId     String
  topic       ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  content     String     @db.Text
  isSolution  Boolean    @default(false)
  workspaceId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([topicId])
  @@index([authorId])
  @@index([workspaceId])
  @@map("forum_posts")
}

// ==================== Comments (Polymorphic) ====================

model Comment {
  id          String        @id @default(uuid())
  entityType  String
  entityId    String
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  content     String        @db.Text
  parentId    String?
  parent      Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[]     @relation("CommentReplies")
  status      CommentStatus @default(PENDING)
  aiRiskScore Float? // AI 内容审核风险分数 0-1
  aiFlags     String[]      @default([]) // AI 标记的标签 [spam, ad, offensive]
  workspaceId String?
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?

  @@index([entityType, entityId, status, parentId])
  @@index([parentId, createdAt])
  @@index([workspaceId])
  @@index([authorId])
  @@map("comments")
}

model SensitiveWord {
  id        String                @id @default(uuid())
  word      String                @unique
  category  SensitiveWordCategory @default(SPAM)
  severity  Int                   @default(1) // 1=low, 2=medium, 3=high
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())

  @@map("sensitive_words")
}

// ==================== Notifications ====================

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  type        NotificationType
  title       String
  content     String
  data        Json?            @default("{}")
  isRead      Boolean          @default(false)
  workspaceId String?
  createdAt   DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([workspaceId])
  @@map("notifications")
}

// ==================== Leads ====================

model DemoBooking {
  id          String           @id @default(uuid())
  name        String
  company     String
  phone       String
  email       String?
  products    String[]         @default([])
  scale       DemoBookingScale @default(SCALE_1_10)
  status      LeadStatus       @default(NEW)
  source      LeadSource       @default(WEBSITE)
  assignedTo  String?
  assignee    User?            @relation("AssignedBookings", fields: [assignedTo], references: [id])
  notes       String?          @db.Text
  workspaceId String?
  followUps   FollowUp[]
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([workspaceId])
  @@map("demo_bookings")
}

model FollowUp {
  id        String      @id @default(uuid())
  bookingId String
  booking   DemoBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type      String
  content   String      @db.Text
  createdBy String
  creator   User        @relation(fields: [createdBy], references: [id])
  createdAt DateTime    @default(now())

  @@index([bookingId])
  @@map("follow_ups")
}

// ==================== Media ====================

model Media {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  url          String
  webpUrl      String?
  thumbUrl     String?
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  createdBy    String
  creator      User     @relation(fields: [createdBy], references: [id])
  createdAt    DateTime @default(now())

  @@index([createdBy])
  @@map("medias")
}

// ==================== Analytics ====================

model PageView {
  id        String   @id @default(uuid())
  path      String
  referrer  String?
  userAgent String?
  ipAddress String?
  userId    String?
  sessionId String
  duration  Int?
  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([sessionId])
  @@map("page_views")
}

model EventTrack {
  id         String   @id @default(uuid())
  event      String
  properties Json?    @default("{}")
  userId     String?
  sessionId  String
  createdAt  DateTime @default(now())

  @@index([event, createdAt])
  @@map("event_tracks")
}

model UserActivity {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  metadata    Json?    @default("{}")
  workspaceId String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([workspaceId])
  @@map("user_activities")
}

// ==================== A/B Testing ====================

model Experiment {
  id           String           @id @default(uuid())
  key          String           @unique
  name         String
  description  String?
  variantA     Json             @default("{}") // { name, config }
  variantB     Json             @default("{}")
  trafficSplit Float            @default(0.5) // B 组流量占比
  status       ExperimentStatus @default(DRAFT)
  winner       String? // A | B | null
  startAt      DateTime?
  endAt        DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("experiments")
}

model ExperimentEvent {
  id           String   @id @default(uuid())
  experimentId String
  variant      String // A | B
  eventType    String // impression, conversion, click
  userId       String?
  sessionId    String
  properties   Json?    @default("{}")
  createdAt    DateTime @default(now())

  @@index([experimentId, variant, eventType])
  @@index([sessionId])
  @@map("experiment_events")
}

// ==================== System ====================

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String   @default("general")
  updatedBy String?
  updater   User?    @relation(fields: [updatedBy], references: [id])
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("settings")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([resource, resourceId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  key       String   @unique
  subject   String
  body      String   @db.Text
  html      String?  @db.Text
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model TokenBlacklist {
  id        String    @id @default(uuid())
  token     String    @unique
  type      TokenType @default(ACCESS)
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
  @@map("token_blacklist")
}

// ==================== Case Studies ====================

model CaseStudy {
  id          String            @id @default(uuid())
  slug        String            @unique
  title       String
  subtitle    String?
  industry    String
  companyName String
  companyLogo String?
  coverImage  String?
  excerpt     String            @db.Text
  challenge   String            @db.Text
  solution    String            @db.Text
  results     String            @db.Text
  quote       String?           @db.Text
  quoteAuthor String?
  quoteTitle  String?
  featured    Boolean           @default(false)
  status      PostStatus        @default(DRAFT)
  publishedAt DateTime?
  viewCount   Int               @default(0)
  sortOrder   Int               @default(0)
  workspaceId String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  metrics     CaseStudyMetric[]

  @@index([industry])
  @@index([featured])
  @@index([status])
  @@index([workspaceId])
  @@map("case_studies")
}

model CaseStudyMetric {
  id          String    @id @default(uuid())
  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  label       String
  value       String
  beforeValue String?
  unit        String?
  sortOrder   Int       @default(0)

  @@index([caseStudyId])
  @@map("case_study_metrics")
}

// ==================== News ====================

model News {
  id           String     @id @default(uuid())
  slug         String     @unique
  title        String
  summary      String?    @db.Text
  content      String     @db.Text
  coverImage   String?
  category     String     @default("company") // company, product, event
  author       String?
  authorAvatar String?
  featured     Boolean    @default(false)
  status       PostStatus @default(DRAFT)
  publishedAt  DateTime?
  viewCount    Int        @default(0)
  workspaceId  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@index([category])
  @@index([featured])
  @@index([status])
  @@index([publishedAt])
  @@index([workspaceId])
  @@map("news")
}

// ==================== Careers ====================

model Job {
  id               String           @id @default(uuid())
  title            String
  department       String
  location         String
  type             String           @default("social") // campus, social, intern
  experience       String           @default("1-3年")
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String           @default("CNY")
  description      String           @db.Text
  responsibilities String           @db.Text
  requirements     String           @db.Text
  benefits         String?          @db.Text
  tags             String[]         @default([])
  status           String           @default("open") // open, closed, paused
  sortOrder        Int              @default(0)
  workspaceId      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  applications     JobApplication[]

  @@index([department])
  @@index([type])
  @@index([status])
  @@index([workspaceId])
  @@map("jobs")
}

model JobApplication {
  id           String   @id @default(uuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String?
  resumeUrl    String?
  coverLetter  String?  @db.Text
  portfolioUrl String?
  status       String   @default("pending") // pending, reviewing, interview, offer, rejected
  source       String   @default("website")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([jobId])
  @@index([status])
  @@map("job_applications")
}

// ==================== About / Team ====================

model TeamMember {
  id         String   @id @default(uuid())
  name       String
  role       String
  title      String
  bio        String?  @db.Text
  avatar     String?
  email      String?
  linkedin   String?
  twitter    String?
  sortOrder  Int      @default(0)
  featured   Boolean  @default(false)
  department String   @default("leadership") // leadership, engineering, product, sales, marketing
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([department])
  @@index([featured])
  @@map("team_members")
}

// ==================== Partners ====================

model Partner {
  id          String   @id @default(uuid())
  name        String
  logo        String?
  website     String?
  description String?  @db.Text
  type        String   @default("technology") // technology, consulting, channel
  level       String   @default("partner") // partner, premier, strategic
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([featured])
  @@map("partners")
}

// ==================== App Marketplace ====================

enum AppStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  SUSPENDED
  DEPRECATED
}

enum PricingModel {
  FREE
  ONE_TIME
  SUBSCRIPTION
  USAGE_BASED
  FREEMIUM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  ALIPAY
  WECHAT_PAY
  BANK_TRANSFER
}

model AppCategory {
  id          String        @id @default(uuid())
  slug        String        @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int           @default(0)
  parentId    String?
  parent      AppCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    AppCategory[] @relation("CategoryHierarchy")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  apps        App[]

  @@index([parentId])
  @@index([sortOrder])
  @@map("app_categories")
}

model AppVendor {
  id               String    @id @default(uuid())
  slug             String    @unique
  name             String
  logoUrl          String?
  website          String?
  description      String?   @db.Text
  contactEmail     String
  contactPhone     String?
  verified         Boolean   @default(false)
  certifications   String[]  @default([])
  revenueShareRate Float     @default(0.70)
  userId           String?
  apps             App[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@map("app_vendors")
}

model App {
  id                String         @id @default(uuid())
  slug              String         @unique
  name              String
  tagline           String
  description       String         @db.Text
  categoryId        String
  category          AppCategory    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags              String[]       @default([])
  vendorId          String
  vendor            AppVendor      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  iconUrl           String
  coverImages       String[]       @default([])
  demoVideoUrl      String?
  pricingModel      PricingModel
  pricingTiers      Json?
  status            AppStatus      @default(DRAFT)
  featured          Boolean        @default(false)
  featuredSortOrder Int?
  installCount      Int            @default(0)
  ratingAvg         Float          @default(0)
  ratingCount       Int            @default(0)
  version           String         @default("1.0.0")
  compatibility     String[]       @default([])
  integrationType   String         @default("oauth")
  reviewNotes       String?        @db.Text
  reviewedBy        String?
  reviewedAt        DateTime?
  workspaceId       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  reviews           AppReview[]
  subscriptions     Subscription[]

  @@index([workspaceId])
  @@index([status])
  @@index([categoryId])
  @@index([vendorId])
  @@index([featured, featuredSortOrder])
  @@index([pricingModel])
  @@map("apps")
}

model AppReview {
  id           String    @id @default(uuid())
  appId        String
  app          App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  userId       String
  workspaceId  String?
  rating       Int
  title        String?
  content      String    @db.Text
  replyContent String?   @db.Text
  replyBy      String?
  replyAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([appId])
  @@index([userId])
  @@index([workspaceId])
  @@map("app_reviews")
}

model Subscription {
  id                 String             @id @default(uuid())
  appId              String
  app                App                @relation(fields: [appId], references: [id], onDelete: Cascade)
  workspaceId        String
  tierName           String
  pricingModel       PricingModel
  amount             Float
  currency           String             @default("CNY")
  interval           String             @default("month")
  status             SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime           @default(now())
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  provider           PaymentProvider?
  providerSubId      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  orders             Order[]

  @@index([appId])
  @@index([workspaceId])
  @@index([status])
  @@index([providerSubId])
  @@map("subscriptions")
}

model Order {
  id                String           @id @default(uuid())
  orderNo           String           @unique
  subscriptionId    String?
  subscription      Subscription?    @relation(fields: [subscriptionId], references: [id])
  workspaceId       String
  userId            String
  subtotal          Float
  discount          Float            @default(0)
  tax               Float            @default(0)
  total             Float
  currency          String           @default("CNY")
  status            PaymentStatus    @default(PENDING)
  paidAt            DateTime?
  provider          PaymentProvider?
  providerPaymentId String?
  invoiceRequested  Boolean          @default(false)
  invoiceNo         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([workspaceId])
  @@index([status])
  @@index([orderNo])
  @@map("orders")
}

// ==================== AI ChatBot ====================

model ChatBotConfig {
  id           String   @id @default(uuid())
  key          String   @unique @default("default")
  intents      Json     @default("[]")
  quickReplies Json     @default("[]")
  fallbackCopy String   @default("抱歉，我暂时无法理解您的问题，建议您预约演示或联系人工客服。")
  updatedAt    DateTime @updatedAt

  @@map("chatbot_configs")
}

model AiChatSession {
  id        String   @id @default(uuid())
  sessionId String   @unique
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@map("ai_chat_sessions")
}
