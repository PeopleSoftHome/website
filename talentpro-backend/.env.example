# Database
DATABASE_URL="postgresql://talentpro:talentpro_dev@localhost:5432/talentpro?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="talentpro_meili_master_key"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# App
APP_PORT=4000
APP_ENV=development
APP_FRONTEND_URL=http://localhost:3000

# Email (optional for dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# File Storage
STORAGE_TYPE=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=talentpro
STORAGE_ACCESS_KEY=talentpro
STORAGE_SECRET_KEY=talentpro_minio_dev

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
