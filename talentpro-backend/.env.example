# ============================================================
# TalentPro 后端环境变量示例
# 复制此文件为 .env 并根据环境修改
# ============================================================

# ─── 应用 ───
APP_PORT=4000
APP_ENV=development
# 前端地址（用于 CORS、邮件/支付回调链接）
APP_FRONTEND_URL=http://localhost:3000
# CORS 允许来源，多个用逗号分隔；留空则默认使用 APP_FRONTEND_URL + http://localhost:8080 + http://localhost:3457
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:3457
# 结构化日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── 数据库 ───
# PostgreSQL 连接字符串（必须）
DATABASE_URL=postgresql://talentpro:talentpro_dev@localhost:5432/talentpro?schema=public

# ─── Redis ───
# Redis 连接字符串（必须）
REDIS_URL=redis://localhost:6379
# Redis 模式：single | cluster | sentinel
REDIS_MODE=single
# Redis Cluster 节点列表（cluster 模式下使用，逗号分隔 host:port）
# REDIS_CLUSTER_NODES=127.0.0.1:7000,127.0.0.1:7001,127.0.0.1:7002
# Redis Sentinel 节点列表（sentinel 模式下使用）
# REDIS_SENTINEL_NODES=127.0.0.1:26379,127.0.0.1:26380
# Redis Sentinel Master 名称
# REDIS_SENTINEL_MASTER_NAME=mymaster
# Redis 缓存键前缀（建议按环境隔离，如 dev: / staging: / prod:）
# 留空时非 development 环境会自动使用 APP_ENV 作为前缀
CACHE_KEY_PREFIX=dev:

# ─── JWT ───
# JWT 签名密钥，生产环境必须 ≥32 位随机字符串（必须）
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# Access Token 过期时间（默认 15m）
JWT_ACCESS_EXPIRATION=15m
# Refresh Token 过期时间（默认 7d）
JWT_REFRESH_EXPIRATION=7d

# ─── 邮件服务 ───
# SMTP 配置（可选，用于发送通知邮件）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@talentpro.cn
SMTP_PASS=your_smtp_password
# 发件人显示名称
MAIL_FROM_NAME=TalentPro
MAIL_FROM_ADDRESS=noreply@talentpro.cn

# ─── 文件存储 ───
# 存储类型：local | s3 | oss（默认 local）
STORAGE_TYPE=local
# 本地存储目录（默认项目根目录 uploads/）
UPLOAD_DIR=./uploads
# 文件访问基础 URL
STORAGE_BASE_URL=/uploads
# S3/OSS 配置（仅在 STORAGE_TYPE=s3 时使用）
# STORAGE_ENDPOINT=https://s3.amazonaws.com
# STORAGE_BUCKET=talentpro
# STORAGE_ACCESS_KEY=your_access_key
# STORAGE_SECRET_KEY=your_secret_key
# STORAGE_REGION=ap-northeast-1

# ─── 限流 ───
# 默认限流时间窗口（毫秒）
THROTTLE_TTL=60000
# 默认限流请求次数
THROTTLE_LIMIT=500
# 严格限流（IP 级别）时间窗口
THROTTLE_STRICT_TTL=60000
# 严格限流（IP 级别）请求次数
THROTTLE_STRICT_LIMIT=100
# 认证相关限流
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10
# 搜索限流
THROTTLE_SEARCH_TTL=60000
THROTTLE_SEARCH_LIMIT=60
# 演示预约表单限流（每小时）
THROTTLE_LEAD_TTL=3600000
THROTTLE_LEAD_LIMIT=5

# ─── Meilisearch ───
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=talentpro_meili_master_key

# ─── Sentry ───
# Sentry DSN（可选，用于错误追踪）
# SENTRY_DSN=https://your-sentry-dsn

# ─── reCAPTCHA ───
# Google reCAPTCHA v3 Secret Key（可选）
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret

# ─── AI Provider 配置 ───
# 当前支持的 Provider：openai / azure / anthropic
# openrouter 尚未实现，配置后会显式报错
AI_PROVIDER=openai

# ─── OpenAI ───
# OpenAI API Key（用于 AI 对话/内容生成功能，可选）
# OPENAI_API_KEY=sk-your-openai-key
# OpenAI 模型（可选，默认 gpt-4o-mini）
# OPENAI_MODEL=gpt-4o-mini
# OpenAI 自定义 Base URL（可选，用于代理）
# 注意：SDK 只需要 host + /v1，不需要 /chat/completions 后缀
# OPENAI_BASE_URL=https://api.openai.com/v1
# OpenAI 生成参数（可选）
# OPENAI_TEMPERATURE=0.7
# OPENAI_MAX_TOKENS=800
# OPENAI_TIMEOUT_MS=30000

# ─── Azure OpenAI ───
# Azure OpenAI API Key（可选）
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# Azure OpenAI Endpoint，例如 https://your-resource.openai.azure.com/
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# Azure OpenAI API 版本（可选，默认 2024-10-21）
# AZURE_OPENAI_API_VERSION=2024-10-21
# Azure OpenAI 部署名称（可选，默认与模型相同）
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_MODEL=gpt-4o-mini
# AZURE_OPENAI_TEMPERATURE=0.7
# AZURE_OPENAI_MAX_TOKENS=800
# AZURE_OPENAI_TIMEOUT_MS=30000
# Azure OpenAI DALL-E 部署名称（可选，默认 dall-e-3）
# AZURE_OPENAI_IMAGE_DEPLOYMENT=dall-e-3
# AZURE_OPENAI_IMAGE_SIZE=1024x1024
# AZURE_OPENAI_IMAGE_QUALITY=standard
# AZURE_OPENAI_IMAGE_STYLE=vivid

# ─── Anthropic ───
# Anthropic API Key（可选）
# ANTHROPIC_API_KEY=your-anthropic-key
# Anthropic 自定义 Base URL（可选）
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Anthropic 模型（可选，默认 claude-sonnet-4-5-20250929）
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# ANTHROPIC_TEMPERATURE=0.7
# ANTHROPIC_MAX_TOKENS=1024
# ANTHROPIC_TIMEOUT_MS=30000

# OpenAI 图片生成参数（可选，用于 /ai/generate-image）
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=standard
OPENAI_IMAGE_STYLE=vivid
AI_IMAGE_PLACEHOLDER_URL=https://placehold.co/1024x576?text=AI+Image

# ─── IP 过滤 ───
# 可信代理列表（CIDR/IPv4/IPv6，逗号分隔），配置后才信任 X-Forwarded-For
# TRUSTED_PROXIES=127.0.0.1/32,::1/128
# 允许访问的 IP/CIDR 白名单（逗号分隔）；配置后仅白名单可访问
# APP_ALLOWED_IPS=
# 拒绝访问的 IP/CIDR 黑名单（逗号分隔）
# APP_BLOCKED_IPS=

# ─── 种子数据 ───
# 初始化管理员密码（首次运行 seed 时使用）
# SEED_ADMIN_PASSWORD=your_secure_admin_password

# ─── PII 加密 ───
# 敏感字段加密密钥（必须，≥32 位随机字符串，生产环境务必独立设置）
PII_ENCRYPTION_KEY=change-me-to-a-random-string-at-least-32-chars
# 邮箱 HMAC-SHA256 哈希密钥，用于 emailHash 索引；未配置时回退到 PII_ENCRYPTION_KEY
# 生产环境强烈建议独立设置，与加密密钥分离
PII_HMAC_KEY=change-me-to-a-random-string-at-least-32-chars

# ─── Stripe 支付 ───
# Stripe Secret Key（可选，用于支付功能）
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Stripe Webhook Secret（可选，用于验证 Webhook 签名）
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Stripe Publishable Key（前端使用，仅作记录）
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
