# Database
DATABASE_URL=postgresql://talentpro:talentpro_dev@localhost:5432/talentpro?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# App
APP_PORT=4000
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3457

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=talentpro_meili_master_key

# MinIO / OSS
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=talentpro
MINIO_SECRET_KEY=talentpro_minio_dev
MINIO_BUCKET=talentpro

# Email (SMTP or SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
MAIL_FROM=noreply@talentpro.cn

# reCAPTCHA
RECAPTCHA_SECRET_KEY=your-recaptcha-secret

# OpenAI (AI ChatBot)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
