# ============================================================
# TalentPro 后端环境变量示例
# 复制此文件为 .env 并根据环境修改
# ============================================================

APP_PORT=4000
APP_ENV=development
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8080,http://localhost:3457
LOG_LEVEL=info

DATABASE_URL=postgresql://talentpro:talentpro_dev@localhost:5432/talentpro?schema=public
REDIS_URL=redis://localhost:6379
REDIS_MODE=single
# 生产建议 cluster 或 sentinel，并按环境隔离 CACHE_KEY_PREFIX
CACHE_KEY_PREFIX=dev:

JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── 文件存储 ───
# production 必须使用 s3/oss，不允许 local filesystem
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
STORAGE_SIGNING_SECRET=change-me-to-a-random-string-at-least-32-chars
SIGNED_URL_TTL_SECONDS=300
# S3/OSS（production 必填）
# STORAGE_TYPE=s3
# STORAGE_ENDPOINT=https://s3.amazonaws.com
# STORAGE_BUCKET=talentpro-private
# STORAGE_REGION=ap-northeast-1
# STORAGE_ACCESS_KEY_ID=your_access_key
# STORAGE_SECRET_ACCESS_KEY=your_secret_key
# STORAGE_FORCE_PATH_STYLE=false

THROTTLE_TTL=60000
THROTTLE_LIMIT=500
THROTTLE_STRICT_TTL=60000
THROTTLE_STRICT_LIMIT=100
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10000
THROTTLE_SEARCH_TTL=60000
THROTTLE_SEARCH_LIMIT=60
THROTTLE_LEAD_TTL=3600000
THROTTLE_LEAD_LIMIT=10000

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=talentpro_meili_master_key

# ─── AI Provider ───
# production 必须配置真实 provider 和对应 API key
AI_PROVIDER=openai
AI_GATEWAY_RPM=30
AI_GATEWAY_MAX_WAIT_MS=60000
AI_GATEWAY_CONCURRENCY=4
AGENT_DEMO_REQUIRE_PROVIDER=false
AI_GOVERNANCE_AUDIT=true

# OpenAI
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=30000

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=your-anthropic-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

SENTRY_DSN=
RECAPTCHA_SECRET_KEY=
TRUSTED_PROXIES=
APP_ALLOWED_IPS=
APP_BLOCKED_IPS=

PII_ENCRYPTION_KEY=change-me-to-a-random-string-at-least-32-chars
PII_HMAC_KEY=change-me-to-a-random-string-at-least-32-chars

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@talentpro.cn
SMTP_PASS=your_smtp_password
SMTP_FROM=TalentPro <noreply@talentpro.cn>

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
