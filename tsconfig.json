{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./src/*"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/shims-vue.d.ts"],
  "exclude": [
    "node_modules",
    ".output",
    "dist",
    "e2e/**/*",
    "talentpro-admin/**/*",
    "talentpro-backend/**/*"
  ]
}
