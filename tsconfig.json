{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/shims-vue.d.ts",
    "src/types/global.d.ts",
    ".nuxt/nuxt.d.ts",
    ".nuxt/imports.d.ts",
    ".nuxt/components.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".output",
    "dist",
    "e2e",
    "talentpro-admin",
    "talentpro-backend"
  ]
}
