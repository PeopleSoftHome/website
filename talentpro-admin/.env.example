# ============================================================
# TalentPro Admin 后台环境变量示例
# 复制此文件为 .env 并根据环境修改
# ============================================================

# API 基础地址（必须）
# 开发环境使用本地后端，生产环境使用真实域名
VITE_API_BASE_URL=http://localhost:4000/api/v1

# 是否生成 Source Map（可选，默认 false）
# SOURCE_MAP=true
