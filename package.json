{
  "name": "talentpro-portal",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "build:all": "npm run build && cd talentpro-backend && npm run build && cd ../talentpro-admin && npm run build",
    "dev:all": "concurrently \"npm run dev\" \"cd talentpro-backend && npm run start:dev\" \"cd talentpro-admin && npm run dev\""
  },
  "dependencies": {
    "@sentry/vue": "^10.54.0",
    "axios": "^1.16.1",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  }
}
