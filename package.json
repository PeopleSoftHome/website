{
  "name": "talentpro-portal",
  "private": true,
  "version": "4.3.2",
  "type": "module",
  "lint-staged": {
    "src/**/*.{js,ts,vue}": [
      "eslint --fix"
    ],
    "e2e/**/*.js": [
      "eslint --fix"
    ]
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "eslint src",
    "validate:tokens": "node scripts/validate-token-sync.cjs",
    "validate:versions": "node scripts/validate-version-sync.cjs",
    "verify:ssg-seo": "node scripts/verify-ssg-seo.cjs",
    "build:all": "npm run build && cd talentpro-backend && npm run build && cd ../talentpro-admin && npm run build",
    "dev:all": "concurrently \"npm run dev\" \"cd talentpro-backend && npm run start:dev\" \"cd talentpro-admin && npm run dev\"",
    "prepare": "husky",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@sentry/vue": "^10.54.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "axios": "^1.16.1",
    "dompurify": "^3.4.11",
    "marked": "^18.0.5",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "nuxt": "^4.4.6",
    "sharp": "^0.34.5",
    "subset-font": "^2.5.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.4"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "form-data": "^4.0.6",
    "js-yaml": "^4.1.2",
    "launch-editor": "^2.14.1",
    "tar": "^7.5.16"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
